{
  "name": "mockmateai-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:prosody": "node scripts/verify-prosody-dsp.mjs",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "npm run setup:assets",
    "prebuild": "npm run setup:assets",
    "verify:expression": "node scripts/verify-expression-metrics.mjs",
    "verify:fingerspelling": "node scripts/verify-fingerspelling.mjs",
    "verify:framebudget": "node scripts/verify-frame-budget.mjs",
    "verify": "npm run verify:prosody && npm run verify:expression && npm run verify:fingerspelling && npm run verify:framebudget && npm run verify:dsagrading && npm run verify:codepanel && npm run verify:theme && npm run verify:nav && npm run verify:nebula && npm run verify:field && npm run verify:asr",
    "setup:pyodide": "node scripts/setup-pyodide.mjs",
    "setup:assets": "npm run setup:mediapipe && npm run setup:pyodide",
    "verify:dsagrading": "node scripts/verify-dsa-grading.mjs",
    "verify:codepanel": "node scripts/verify-code-panel-share.mjs",
    "verify:theme": "node scripts/verify-theme-contrast.mjs",
    "verify:nav": "node scripts/verify-navigation.mjs",
    "verify:nebula": "node scripts/verify-nebula-field.mjs",
    "verify:field": "node scripts/verify-field-legibility.mjs",
    "verify:asr": "node scripts/verify-asr-turn.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "pdfjs-dist": "6.3.289",
    "pyodide": "314.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
