# Copy to `.env` for local development. Never commit a populated `.env`
# (Section 21.1) — only this example file with placeholders is tracked.

MOCKMATEAI_ENV=development

# --- Datastores ---
MOCKMATEAI_DB_URL=postgresql+psycopg://mockmateai:mockmateai@localhost:5432/mockmateai
MOCKMATEAI_REDIS_URL=redis://localhost:6379/0
# MOCKMATEAI_RATE_LIMIT_REDIS_URL=redis://localhost:6379/1

# --- JWT (Section 12.1) — generate with: python scripts/generate_dev_keys.py ---
MOCKMATEAI_JWT_PRIVATE_KEY_PATH=./dev_keys/jwt_private.pem
MOCKMATEAI_JWT_PUBLIC_KEY_PATH=./dev_keys/jwt_public.pem
MOCKMATEAI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOCKMATEAI_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MOCKMATEAI_REFRESH_TOKEN_SECRET=change-me-to-a-long-random-string

MOCKMATEAI_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Google OAuth (Section 6.5 / 12.10) — from Google Cloud Console ---
MOCKMATEAI_GOOGLE_CLIENT_ID=
MOCKMATEAI_GOOGLE_CLIENT_SECRET=
MOCKMATEAI_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
MOCKMATEAI_FRONTEND_URL=http://localhost:5173

# --- CORS (Section 12.7 — explicit allowlist, never "*") ---
MOCKMATEAI_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting (Section 12.1A) ---
# MOCKMATEAI_RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

MOCKMATEAI_RECORDING_RETENTION_DAYS=90

# --- LLM providers (Section 6.7) ---
#
# TO TURN ON REAL QUESTIONS AND REAL EVALUATION: paste one API key below.
# That is the whole procedure. Leave PROVIDER_ORDER on `auto` and the provider
# is recognised from the key's own prefix — `sk-ant-...` is Anthropic,
# `sk-...` is OpenAI — so there is no second setting to keep in sync.
#
# With no key, every turn is answered by `mock`: a real, deterministic,
# rule-based adapter (no key, no SDK, no cost) that runs full interviews
# immediately on a fresh clone. It is genuinely useful and it is genuinely
# limited — its follow-ups are templated and it cannot tell a correct answer
# from an incorrect one, because it does not read for meaning. If interviews
# keep asking the same follow-up, this is why; the backend logs a warning
# saying so at startup.
#
# `mock` is always appended last, so an expired key, a rate limit or an outage
# degrades to a working-but-unintelligent interview rather than a dead session.
# Set an explicit chain instead (`anthropic,openai,mock`) to pin the order --
# then keys pair positionally with it, in the order written.
MOCKMATEAI_LLM_PROVIDER_ORDER=auto
# On `auto` any of these three slots is fine; the first recognised key wins and
# a second key for a *different* provider becomes the failover.
MOCKMATEAI_LLM_API_KEY=
MOCKMATEAI_LLM_FALLBACK_API_KEY_1=
MOCKMATEAI_LLM_FALLBACK_API_KEY_2=

# Model per provider. Claude Opus 5 is the Anthropic default — note that on
# Opus 5 `temperature` is rejected outright, so response style is steered by
# prompting (see services/ai/anthropic_adapter.py).
MOCKMATEAI_ANTHROPIC_MODEL=claude-opus-5
MOCKMATEAI_OPENAI_MODEL=gpt-4o

# Section 14's sub-2-second turn budget is why effort defaults low. Raise for
# better evaluation quality at the cost of latency: low|medium|high|xhigh|max.
MOCKMATEAI_LLM_EFFORT=low
MOCKMATEAI_LLM_REQUEST_TIMEOUT_SECONDS=12
MOCKMATEAI_LLM_DEGRADED_AFTER_CONSECUTIVE_FAILURES=3
MOCKMATEAI_LLM_DEGRADED_COOLDOWN_SECONDS=60

# --- LLM token/cost governance (Section 9.3A) ---
MOCKMATEAI_LLM_MAX_TOKENS_PER_TURN=500
# Caps thinking + response together on thinking-capable models, so leave
# headroom — too tight and answers truncate mid-JSON.
MOCKMATEAI_LLM_MAX_OUTPUT_TOKENS=4096
# Session ceiling is this multiplied by the session's duration in minutes, so
# a 45-minute interview gets 3x a 15-minute one's budget.
MOCKMATEAI_LLM_MAX_TOKENS_PER_SESSION_PER_MINUTE=4000
MOCKMATEAI_LLM_COMPACTION_THRESHOLD_RATIO=0.6
MOCKMATEAI_LLM_FULL_TURNS_KEPT_WHEN_COMPACTING=4
MOCKMATEAI_LLM_MAX_CALLS_PER_SESSION=40

# --- AI-cost-sensitive quota (Section 12.1A) ---
# Per-user daily interview minutes, on top of per-IP request rate limiting.
# Set to 0 to disable.
MOCKMATEAI_AI_DAILY_INTERVIEW_MINUTES_PER_USER=180

# Transcript / PDF downloads and report regenerations, per user per hour.
# Keyed per account rather than per IP so a shared network doesn't let one
# user exhaust everyone else's allowance. Set to 0 to disable.
MOCKMATEAI_EXPORTS_PER_HOUR_PER_USER=20

# Off by default — calls an external k-anonymity API at signup time (see
# app/core/security.py::is_breached_password). Enable only if you want
# that outbound network dependency in your environment.
MOCKMATEAI_ENABLE_BREACHED_PASSWORD_CHECK=false
